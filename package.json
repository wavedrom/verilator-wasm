{
  "name": "verilator-wasm",
  "version": "0.1.0",
  "description": "Verilator compiled to WebAssembly, with an in-memory filesystem",
  "homepage": "https://github.com/wavedrom/verilator-wasm#readme",
  "bugs": {
    "url": "https://github.com/wavedrom/verilator-wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavedrom/verilator-wasm.git"
  },
  "license": "(MIT AND (LGPL-3.0-only OR Artistic-2.0))",
  "author": "",
  "keywords": [
    "verilator",
    "wasm",
    "wasi",
    "webassembly",
    "verilog",
    "systemverilog",
    "lint",
    "json-only",
    "hdl"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./verilator.wasm": "./dist/verilator.wasm"
  },
  "bin": {
    "verilator-wasm": "bin/verilator-wasm.mjs"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "dist/",
    "bin/verilator-wasm.mjs",
    "lib/index.mjs",
    "lib/index.d.ts",
    "lib/vfs.mjs",
    "lib/wasi.mjs",
    "gen/vroot-data.mjs",
    "NOTICE",
    "LICENSES/"
  ],
  "scripts": {
    "build": "node bin/build.js",
    "build:wasm": "node bin/build.js --stage 2,3",
    "build:pack": "node bin/build.js --stage 3",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
